{
  "name": "academia-fitzone",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestão da academia FitZone",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:demo": "node src/server.js --demo",
    "start:lan": "node --env-file-if-exists=.env src/server.js --demo --lan",
    "start:mysql:lan": "node --env-file-if-exists=.env src/server.js --lan",
    "test": "node --test --test-isolation=none",
    "demo": "node examples/atendimento.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.14.0"
  }
}
